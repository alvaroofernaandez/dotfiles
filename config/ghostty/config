# =============================================================================
# Ghostty — Tokyo Night
# Docs: ghostty +show-config --default --docs
# Reload: cmd+shift+, (or restart)
# =============================================================================

# --- Theme -------------------------------------------------------------------
# Follows the macOS appearance automatically.
# Dark variants: TokyoNight, TokyoNight Night, TokyoNight Storm, TokyoNight Moon
# Light variant: TokyoNight Day
theme = dark:TokyoNight Night,light:TokyoNight Day

# Do NOT hardcode cursor-color / selection-* here: each TokyoNight variant
# already ships its own, and a fixed value would break one of the two modes.
unfocused-split-opacity = 0.82

# --- Typography --------------------------------------------------------------
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true

# Vertical breathing room between lines
adjust-cell-height = 14%

# Disable ligatures if you dislike them:
# font-feature = -calt
# font-feature = -liga

# --- Window ------------------------------------------------------------------
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-theme = ghostty
window-save-state = always
window-inherit-working-directory = true

# `tabs` looks nicer but has a known Ghostty bug: its titlebar style does not
# update when the system switches light/dark. `transparent` follows the theme.
macos-titlebar-style = transparent
# Keep Option as a composition modifier, NOT as Alt/meta. On a Spanish - ISO
# layout, Option is required for @ | # [ ] { } \ ~ — treating it as Alt breaks
# every one of them. Nothing here needs meta: the only <A-…> mappings in Neovim
# (config/keymaps.lua) are <Nop>, and neither tmux nor zsh bind meta keys.
# Ghostty resolves its own keybinds (cmd+alt+hjkl below) before this setting, so
# split navigation is unaffected.
macos-option-as-alt = false
macos-window-shadow = true

# Translucent background with blur
background-opacity = 0.94
background-blur = 24

# --- Cursor ------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Startup -----------------------------------------------------------------
# Attach to the shared tmux session, creating it only if absent. The tmux server
# outlives Ghostty, so this costs ~970ms once after a reboot and ~9ms on every
# window afterwards. Escape hatch: `ghostty -e zsh` for a plain shell.
command = /Users/alvaroofernaandez/.config/ghostty/launch.sh

# --- Behavior ----------------------------------------------------------------
copy-on-select = clipboard
confirm-close-surface = false
scrollback-limit = 100000
shell-integration = zsh
shell-integration-features = cursor,sudo,title
clipboard-read = allow
clipboard-write = allow

# --- Keybindings -------------------------------------------------------------
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
# Moving between splits. Ghostty has no "go to split N" — goto_split takes
# directions and previous/next only — so there are two routes:
#
#   home row  : precise jumps without moving your hand to the arrow keys
#   cycling   : sweep through many splits with one repeated chord
#
# ctrl+hjkl is deliberately NOT used: Ghostty receives keys before tmux, so it
# would shadow vim-tmux-navigator inside every session. cmd+h/m/q are left alone
# because macOS uses them to hide, minimise and quit.
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right

# Arrows kept as an alias: same action, no relearning required.
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# Cycle through every split in order. With eight open this reaches any of them
# without thinking about the layout.
keybind = cmd+bracket_left=goto_split:previous
keybind = cmd+bracket_right=goto_split:next
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+k=clear_screen

# Paste an image into a TUI that reads the system clipboard itself (Claude Code,
# for one). cmd+v cannot do this: it runs paste_from_clipboard, a terminal action
# that can only push TEXT down the pty, and image bytes do not fit through it.
# Those programs listen for ctrl+v — 0x16 — and read the clipboard natively,
# bypassing the pty. So this sends that byte rather than rebinding cmd+v, which
# would cost text pasting everywhere else (and 0x16 is quoted-insert in zsh).
keybind = cmd+shift+v=text:\x16
keybind = cmd+shift+r=reload_config

# Drop-down terminal from anywhere (needs Accessibility permission on macOS)
keybind = global:cmd+grave_accent=toggle_quick_terminal

quick-terminal-position = top
quick-terminal-animation-duration = 0.12

{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "code-ninja": {
      "description": "Concise, code-first persona for fast implementation",
      "mode": "subagent",
      "prompt": "{file:/Users/alvaroofernaandez/.config/opencode/agents/code-ninja.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "senior-architect": {
      "description": "Senior Architect persona - helpful first, challenging when it matters",
      "mode": "subagent",
      "prompt": "{file:/Users/alvaroofernaandez/.config/opencode/agents/senior-architect.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    }
  },
  "autoupdate": true,
  "model": "opencode-go/deepseek-v4-flash",
  "plugin": [
    "opencode-wakatime"
  ],
  "mcp": {
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local",
      "environment": {
        "ENGRAM_CLOUD_AUTOSYNC": "1",
        "ENGRAM_CLOUD_SERVER": "{env:ENGRAM_CLOUD_SERVER}",
        "ENGRAM_CLOUD_TOKEN": "{env:ENGRAM_CLOUD_TOKEN}"
      }
    }
  }
}

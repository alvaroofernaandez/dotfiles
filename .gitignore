# Backups created by install.sh
*.bak.*
# Editor/tool backups picked up from source configs
*.bak
*.backup-*

node_modules/

# macOS
.DS_Store

# Design notes stay local, not published
.agents/

# Shell secrets stay out of version control
secrets.zsh
config/zsh/secrets.zsh

# Auto-generated index of every agent skill installed on this machine, rebuilt by
# scanning $HOME. It therefore lists whatever happens to be installed — private and
# client skills included, with their absolute paths — and rewrites itself on every
# refresh. Sanitising it once does not hold: the next refresh puts the material back.
# It stays local; the orchestrator reads it from disk, not from git.
.atl/

# Installer binaries. Built from source or downloaded per platform, never
# committed: a 3 MB binary per platform in git history for something that is
# rebuilt on every push is pure weight.
/bin/
/dist/
/dist-npm/

# gstack's vendored runtime: 42 MB of upstream source plus a Bun build plus the
# Chromium that Playwright downloads. Reproducible from GSTACK_PIN by
# scripts/gstack-sync.sh, so committing it would add weight and nothing else.
# The part that matters — the fifteen patched skills — IS committed, under
# shared/skills/, precisely so that changes to them show up in a diff.
#
# It lives in third_party/ rather than vendor/ because this repo is a Go module
# and `vendor/` at a module root is reserved: Go reads it as its own dependency
# tree and refuses to build without a matching vendor/modules.txt. Putting
# gstack there broke `go build ./...` for the installer.
/third_party/
